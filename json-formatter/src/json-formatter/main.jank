(ns json-formatter.main
  (:require [clojure.string :as string]
            [jank.perf :as perf]
            ;; from: jank-json
            [jank-json.core :as json])
  ;; from: jank-glfw
  (:include "GLFW/glfw3.h"))

(def input-str (str "{\"glfw\": {\"version\": \"" (cpp/glfwGetVersionString) "\"}}"))

(defn -main [& args]
  (println (json/format-json input-str))

  (perf/bench
   {:label  "format-json"
    :epochs 100}
   (json/format-json input-str)))
